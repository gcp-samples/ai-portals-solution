# Google Cloud & Apigee configuration
export GOOGLE_CLOUD_PROJECT=your-gcp-project-id
export GOOGLE_CLOUD_LOCATION=europe-west1
# Optional overrides (auto-discovered from Apigee if omitted)
# export APIGEE_ENVIRONMENT=eval
# export PROXY_SA=portal-service@your-gcp-project-id.iam.gserviceaccount.com

# Frontend portal configuration (injected into app.js during build)
export FRONTEND_DEMO_MODE=false
export FRONTEND_PORTAL_ID=demo
export FRONTEND_API_HOST=
export FRONTEND_OIDC_ENDPOINT=
export FRONTEND_CLIENT_ID=

# Google OAuth 2.0 credentials for upstream Google Sign-In in OIDC proxy (optional)
export GOOGLE_CLIENT_ID=
export GOOGLE_CLIENT_SECRET=

# Machine-to-machine Portal Admin OAuth client (client_credentials + portal:admin scope)
export PORTAL_ADMIN_CLIENT_ID=portal-admin
export PORTAL_ADMIN_CLIENT_SECRET=
